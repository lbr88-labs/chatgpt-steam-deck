[Desktop Entry]
Type=Application
Version=1.0
Name=Install ChatGPT Community
Comment=Install, update, or remove ChatGPT Community on Steam Deck
Icon=system-software-install
Terminal=true
Exec=bash -c "install -d -m 700 ~/.cache/chatgpt-steam-deck; ref=refs/heads/main; if command -v git >/dev/null; then latest=\\$(git ls-remote https://github.com/lbr88-labs/chatgpt-steam-deck.git refs/heads/main | cut -f1); if [[ \\$latest =~ ^[0-9a-f]{40} ]]; then ref=\\$latest; fi; fi; export CHATGPT_INSTALLER_REF=\\$ref; curl --fail --location --proto =https --tlsv1.2 --retry 3 --output ~/.cache/chatgpt-steam-deck/installer.sh https://raw.githubusercontent.com/lbr88-labs/chatgpt-steam-deck/\\$ref/installer.sh?ts=\\$(date +%%s) && chmod 700 ~/.cache/chatgpt-steam-deck/installer.sh && ~/.cache/chatgpt-steam-deck/installer.sh || { echo Installer-failed.; if command -v zenity >/dev/null; then zenity --error --text='Installer failed. See the terminal output for details.'; else read -r; fi; }"
Categories=Utility;
Keywords=ChatGPT;OpenAI;Steam Deck;installer;
StartupNotify=true
